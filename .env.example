# Copy to .env and fill in values. Never commit .env.

# App
APP_ENV=development
APP_NAME="My Family Tree"
LOG_LEVEL=info
SECRET_KEY=change-me-in-production

# Postgres
POSTGRES_USER=my_family_tree
POSTGRES_PASSWORD=my_family_tree
POSTGRES_DB=my_family_tree
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://my_family_tree:my_family_tree@db:5432/my_family_tree
DATABASE_URL_SYNC=postgresql+psycopg://my_family_tree:my_family_tree@db:5432/my_family_tree

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO local; real S3 in prod)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=my-family-tree-local
S3_SECRET_KEY=my-family-tree-local-secret
S3_BUCKET_DOCUMENTS=my-family-tree
S3_FORCE_PATH_STYLE=true

# LLM providers (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-5.5
LLM_DEFAULT_REASONING_EFFORT=high
LLM_EMBEDDING_MODEL=text-embedding-3-large

# OCR
TESSERACT_BIN=/usr/bin/tesseract
VISION_FALLBACK_PROVIDER=openai
VISION_FALLBACK_DAILY_USD_CAP=5.00

# MCP
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765

# Web search (optional; provider-native used otherwise)
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ALLOW_ORIGINS=http://localhost:5173

# Frontend (Vite, prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="My Family Tree"
